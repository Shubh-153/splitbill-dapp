# Copy this file to .env and fill in your own values before deploying to Sepolia.
# Never commit your real .env file or private key.

# An RPC URL for Sepolia testnet, e.g. from Alchemy or Infura:
# https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_RPC_URL=

# Private key of a wallet funded with Sepolia test ETH (from a faucet).
# Export this from MetaMask -> Account details -> Show private key.
# Use a throwaway/test wallet, never your main wallet.
PRIVATE_KEY=
